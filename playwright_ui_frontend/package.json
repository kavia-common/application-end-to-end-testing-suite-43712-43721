{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",

    "pw": "playwright test",
    "pw:report": "playwright show-report",

    "pw:ui:xvfb": "PW_XDG_OPEN=0 xvfb-run -a -s '-screen 0 1280x720x24' playwright test --ui",
    "pw:ui": "npm run pw:ui:xvfb",
    "pw:headless": "PW_XDG_OPEN=0 playwright test --reporter=list",

    "postinstall": "playwright install --with-deps || npx playwright install --with-deps || true"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@playwright/test": "^1.49.0"
  }
}
